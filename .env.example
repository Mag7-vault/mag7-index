# --- Foundry / deploy ---
ROBINHOOD_CHAIN_RPC=            # RPC URL for chain 4663
DEPLOYER_PRIVATE_KEY=           # deployer EOA, unfunded testnet key while iterating
KEEPER_ADDRESS=                 # address allowed to post prices + call rebalance
INITIAL_DEPOSIT_CAP=10000000000 # 10,000 USDG at 6 decimals — mirrors DOSS's launch-week cap
BLOCKSCOUT_API_KEY=             # for `forge script --verify`

# --- keeper/post-prices.mjs ---
PRICE_ORACLE_ADDRESS=           # from Deploy.s.sol console output
KEEPER_PRIVATE_KEY=             # matches KEEPER_ADDRESS above — keep this one scoped, not the deployer key
