# Public endpoints may be overridden with a private provider.
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com # chain 4663
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com # chain 46630

# Deployment. Never reuse either keeper key as the deployer/owner key.
DEPLOYER_PRIVATE_KEY=
ORACLE_KEEPER_ADDRESS=
REBALANCE_KEEPER_ADDRESS=
EXPECTED_SAFE_SINGLETON=  # independently verified Safe singleton implementation
EXPECTED_SAFE_CODEHASH=   # independently verified Safe proxy runtime code hash
INITIAL_DEPOSIT_CAP=0           # mainnet must launch closed; timelock opens Gate C
TESTNET_DEPOSIT_CAP=1000000000  # 1,000 demo USDG
BLOCKSCOUT_API_KEY=

# Governance handover (Deploy.s.sol). SAFE_ADDRESS is REQUIRED on mainnet (4663):
# the deploy sets it as the instant-pause guardian and hands ownership of both
# contracts to a TimelockController whose only proposer/executor is the Safe.
# Ownership is two-step, so it only takes effect once the Safe schedules+executes
# acceptOwnership() through the timelock (see docs/runbook-canary.md).
SAFE_ADDRESS=
TIMELOCK_MIN_DELAY=172800 # 48h in seconds

# Keeper runtime (mainnet only; canonical Voxel contracts are on chain 4663).
INDEX_VAULT_ADDRESS=
PRICE_ORACLE_ADDRESS=
BASKET_SYMBOLS=NVDA,AAPL,TSLA,GOOGL,AMZN
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_BPS=100
REBALANCE_TOLERANCE_BPS=25
SWAP_DEADLINE_SECONDS=300
RESTORE_USDG_AMOUNT=

# Keeper signer. Default "raw" reads the scoped keys below. Set KEEPER_SIGNER_KIND=module
# and KEEPER_SIGNER_MODULE to a file exporting createSigner(provider, role) to sign from a
# KMS/HSM instead (see keeper/signers/aws-kms.example.mjs) — then the raw keys are unused.
KEEPER_SIGNER_KIND=raw
KEEPER_SIGNER_MODULE=
ORACLE_KEEPER_PRIVATE_KEY=
REBALANCE_KEEPER_PRIVATE_KEY=
# ORACLE_KMS_KEY_ID=       # used by the AWS KMS reference signer
# REBALANCE_KMS_KEY_ID=

# Webhook alerting (Slack or Discord). Optional; alerts are non-fatal if unset.
# Kind auto-detects from the URL; override with ALERT_WEBHOOK_KIND=slack|discord.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=

# Market-cap feed for IndexVault's MARKET_CAP weighting mode (post-market-caps.mjs).
# Only needed once the vault is switched to MARKET_CAP; "static" posts equal weights.
MARKETCAP_PROVIDER=static # static | equal | http | module
MARKETCAP_API_BASE=       # http provider: GET <base>?symbols=NVDA,AAPL,...
MARKETCAP_API_KEY=        # http provider: sent as Bearer token if set
MARKETCAP_MODULE=         # module provider: path exporting fetchMarketCaps(symbols)
MARKETCAP_SNAPSHOT=       # optional override for the last-known snapshot path

# NOTE: the permissionless-rebalance policy (interval, drift threshold, slippage
# floor, notional cap) lives ON-CHAIN via setRebalancePolicy and is set through
# the timelock — not here. It ships disabled (zero notional) until enabled.
